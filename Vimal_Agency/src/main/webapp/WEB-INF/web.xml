<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- Static Resource Caching (Performance) -->
    <filter>
        <filter-name>ExpiresFilter</filter-name>
        <filter-class>org.apache.catalina.filters.ExpiresFilter</filter-class>
        <init-param>
            <param-name>ExpiresByType image</param-name>
            <param-value>access plus 30 days</param-value>
        </init-param>
        <init-param>
            <param-name>ExpiresByType text/css</param-name>
            <param-value>access plus 7 days</param-value>
        </init-param>
        <init-param>
            <param-name>ExpiresByType application/javascript</param-name>
            <param-value>access plus 7 days</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>ExpiresFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- Contact Add -->
    <servlet>
        <servlet-name>Contact_add</servlet-name>
        <servlet-class>Contact_add</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>Contact_add</servlet-name>
        <url-pattern>/Contact_add</url-pattern>
    </servlet-mapping>


    <!-- Login Servlet Mapping Removed as class loginproc doesn't exist (handled via JSP) -->

    <!-- Feedback Add -->
    <servlet>
        <servlet-name>Feedback_add</servlet-name>
        <servlet-class>Feedback_add</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>Feedback_add</servlet-name>
        <url-pattern>/Feedback_add</url-pattern>
    </servlet-mapping>


    <!-- Contact Add ADMIN -->
    <servlet-mapping>
        <servlet-name>Contact_add</servlet-name>
        <url-pattern>/admin/Contact_add</url-pattern>
    </servlet-mapping>


    <!-- Contact Save ADMIN Servlet Mapping Removed as class Contact_save doesn't exist -->
    <!-- Welcome Page -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
   <servlet-name>Offers_add</servlet-name>
   <servlet-class>Offers_add</servlet-class>
</servlet>

<servlet-mapping>
   <servlet-name>Offers_add</servlet-name>
   <url-pattern>/Offers_add</url-pattern>
</servlet-mapping>


</web-app>









