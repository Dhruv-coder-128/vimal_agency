<%!
    // ઈમેલ મોકલવા માટેનું ફંક્શન
    public boolean sendInvoiceMail(String to, String orderRef, String customer) {
        final String user = "vimalagency.noreply@gmail.com";
        final String pass = "dajh htdo abmr pgvd"; // અહીં એપ પાસવર્ડ નાખવો

        Properties props = new Properties();
        props.put("mail.smtp.auth", "true");
        props.put("mail.smtp.starttls.enable", "true");
        props.put("mail.smtp.host", "smtp.gmail.com");
        props.put("mail.smtp.port", "587");

        Session mailSession = Session.getInstance(props, new javax.mail.Authenticator() {
            protected PasswordAuthentication getPasswordAuthentication() {
                return new PasswordAuthentication(user, pass);
            }
        });

        try {
            Message message = new MimeMessage(mailSession);
            message.setFrom(new InternetAddress(user));
            message.setRecipients(Message.RecipientType.TO, InternetAddress.parse(to));
            message.setSubject("Invoice for Order " + orderRef);
            message.setText("Hello " + customer + ",\nYour order " + orderRef + " is confirmed!");
            Transport.send(message);
            return true;
        } catch (Exception e) {
            e.printStackTrace();
            return false;
        }
    }
%>

