<%
    // Order Cancellation Logic (DO NOT REMOVE)
    try {
        String cancelId = request.getParameter("cancel_id");
        if(cancelId != null) {
            int u_id = (Integer)session.getAttribute("user_id");
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection con = DriverManager.getConnection("jdbc:mysql://localhost:3306/vimal_agency?useUnicode=yes&characterEncoding=UTF-8","root","");
            PreparedStatement psCancel = con.prepareStatement("UPDATE orders SET status = 'Cancelled' WHERE order_id = ? AND user_id = ? AND status = 'Pending'");
            psCancel.setString(1, cancelId);
            psCancel.setInt(2, u_id);
            int updated = psCancel.executeUpdate();
            con.close();
            response.sendRedirect("my_orders.jsp?msg=" + (updated > 0 ? "cancelled" : "error"));
            return;
        }
    } catch(Exception e) { out.print(e); }
%>

<div class="account-header no-print">
    <div class="container">
        <h1 class="fw-800 h2 mb-2">Order History</h1>
        <p class="text-white-50">Track, manage and download your agency invoices.</p>
    </div>
</div>

<div class="container main-content-wrapper pb-5 no-print">
    <%
        try {
            int u_id = (Integer)session.getAttribute("user_id");
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection con = DriverManager.getConnection("jdbc:mysql://localhost:3306/vimal_agency?useUnicode=yes&characterEncoding=UTF-8","root","");
            
            PreparedStatement ps = con.prepareStatement("SELECT * FROM orders WHERE user_id = ? ORDER BY order_id DESC");
            ps.setInt(1, u_id);
            ResultSet rs = ps.executeQuery();
            SimpleDateFormat sdf = new SimpleDateFormat("MMM dd, yyyy");

            while(rs.next()){
                int oId = rs.getInt("order_id");
                int finalTotal = rs.getInt("final_total");
                int dbDiscount = rs.getInt("discount");
                int dbSubtotal = finalTotal + dbDiscount; 
                String cName = rs.getString("customer_name");
                String status = rs.getString("status");
                
                String statusClass = status.equalsIgnoreCase("Pending") ? "status-pending" : (status.equalsIgnoreCase("Cancelled") ? "status-cancelled" : "status-delivered");
                String progressColor = status.equalsIgnoreCase("Pending") ? "var(--warning)" : (status.equalsIgnoreCase("Cancelled") ? "var(--danger)" : "var(--success)");
                int progressWidth = status.equalsIgnoreCase("Pending") ? 45 : 100;
    %>

    <div class="order-card-pro" id="order-<%= oId %>">
        <input type="hidden" class="db-final-total" value="<%= finalTotal %>">
        <input type="hidden" class="db-discount" value="<%= dbDiscount %>">
        <input type="hidden" class="db-subtotal" value="<%= dbSubtotal %>">
        <input type="hidden" class="db-customer-name" value="<%= cName %>">
        
        <div class="card-header-grid">
            <div><span class="label-sm">Order Date</span><span class="value-md order-date text-nowrap"><%= sdf.format(rs.getTimestamp("order_date")) %></span></div>
            <div><span class="label-sm">Total Amount</span><span class="value-md text-primary order-total">₹<%= finalTotal %></span></div>
            <div><span class="label-sm">Ship To</span><span class="value-md text-truncate d-block"><%= rs.getString("city") %></span></div>
            <div class="text-md-end"><span class="label-sm">Order ID</span><span class="value-md order-ref">#VML-<%= oId %></span></div>
        </div>

        <div class="status-box">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <span class="badge-status <%= statusClass %>">
                            <i class="fa-solid fa-circle-dot small"></i> <%= status.toUpperCase() %>
                        </span>
                        <span class="fw-bold text-dark h6 mb-0">
                            <%= status.equalsIgnoreCase("Pending") ? "Order In Processing" : (status.equalsIgnoreCase("Cancelled") ? "Order Terminated" : "Package Delivered Successfully") %>
                        </span>
                    </div>
                    <div class="timeline-bar">
                        <div class="timeline-fill" style="width: <%= progressWidth %>%; background: <%= progressColor %>;"></div>
                    </div>
                </div>
                <div class="col-lg-6 text-lg-end">
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        <% if(status.equalsIgnoreCase("Pending")) { %>
                            <button class="btn btn-outline-danger border-0 fw-800 px-3" style="font-size: 0.85rem;" onclick="confirmCancel(<%= oId %>)">
                                <i class="fa-solid fa-ban me-1"></i> Cancel
                            </button>
                        <% } %>
                        <button class="btn-action-outline" onclick="generateInvoice(<%= oId %>, 'print')">
                            <i class="fa-solid fa-print text-primary"></i> Print
                        </button>
                        <button class="btn-action-outline" onclick="generateInvoice(<%= oId %>, 'pdf')">
                            <i class="fa-solid fa-file-pdf text-danger"></i> PDF
                        </button>
                        <button class="btn btn-dark fw-800 px-4" style="border-radius:12px" onclick="toggleDetails(<%= oId %>)">
                            Items
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="details-<%= oId %>" class="details-drawer">
            <div class="row g-4">
                <div class="col-lg-8">
                    <h6 class="fw-800 text-dark mb-4"><i class="fa-solid fa-box-open me-2 text-primary"></i>Ordered Summary</h6>
                    <%
                        PreparedStatement psItems = con.prepareStatement("SELECT * FROM order_items WHERE order_id = ?");
                        psItems.setInt(1, oId);
                        ResultSet rsI = psItems.executeQuery();
                        while(rsI.next()) {
                    %>
                    <div class="d-flex align-items-center mb-3 p-3 bg-white rounded-4 border item-row shadow-sm">
                        <img src="<%= rsI.getString("image") %>" class="item-thumb-pro me-3 product-img border-0">
                        <div class="flex-grow-1">
                            <h6 class="mb-1 fw-bold text-dark product-name"><%= rsI.getString("product_name") %></h6>
                            <span class="text-muted small fw-600">Quantity: <span class="qty"><%= rsI.getInt("qty") %></span> Units</span>
                        </div>
                        <div class="text-end fw-800 text-dark item-total">₹<%= rsI.getInt("qty") * rsI.getInt("price") %></div>
                    </div>
                    <% } %>
                </div>
                <div class="col-lg-4">
                    <div class="p-4 bg-white rounded-4 border shadow-sm h-100">
                        <h6 class="fw-800 text-dark mb-3"><i class="fa-solid fa-location-dot me-2 text-primary"></i>Shipping Information</h6>
                        <p class="small text-muted mb-2">Customer: <strong class="text-dark"><%= cName %></strong></p>
                        <p class="small text-muted mb-0">Address:</p>
                        <p class="small fw-bold text-dark address-text" style="line-height: 1.6;"><%= rs.getString("address") %>, <%= rs.getString("city") %></p>
                        <hr class="my-3 opacity-10">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-muted fw-600">Payment Mode</span>
                            <span class="badge bg-light text-dark fw-700">Cash on Delivery</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <% } con.close(); } catch(Exception e) { out.print(e); } %>
</div>

