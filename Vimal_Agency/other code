<script>
    // Logic: Toggle Order Items (DO NOT REMOVE)
    function toggleDetails(id) {
        const el = document.getElementById("details-" + id);
        if(el.style.display === "block") {
            el.style.display = "none";
        } else {
            el.style.display = "block";
        }
    }

    // Logic: Cancel Confirmation (DO NOT REMOVE)
    function confirmCancel(id) {
        if(confirm('Warning: Are you sure you want to cancel this order? This action cannot be reversed.')) {
            window.location.href = 'my_orders.jsp?cancel_id=' + id;
        }
    }

    // Logic: Generate Professional Invoice PDF/Print (DO NOT REMOVE)
    function generateInvoice(id, mode) {
        const card = document.getElementById('order-' + id);
        const details = document.getElementById('details-' + id);
        
        // Dynamic Data Fetching
        document.getElementById('print-orderid').innerText = card.querySelector('.order-ref').innerText;
        document.getElementById('print-date').innerText = card.querySelector('.order-date').innerText;
        document.getElementById('print-address').innerText = details.querySelector('.address-text').innerText;
        document.getElementById('print-customername').innerText = card.querySelector('.db-customer-name').value;
        
        document.getElementById('print-subtotal').innerText = "₹" + card.querySelector('.db-subtotal').value;
        document.getElementById('print-discount').innerText = "- ₹" + card.querySelector('.db-discount').value;
        document.getElementById('print-total').innerText = "₹" + card.querySelector('.db-final-total').value;
        
        // Build Items Table with UI
        const tableBody = document.getElementById('print-items-table');
        tableBody.innerHTML = '';
        const items = details.querySelectorAll('.item-row');
        
        items.forEach(item => {
            const name = item.querySelector('.product-name').innerText;
            const qty = item.querySelector('.qty').innerText;
            const total = item.querySelector('.item-total').innerText;
            const imgUrl = item.querySelector('.product-img').src;
            
            tableBody.innerHTML += `
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 15px; display: flex; align-items: center;">
                        <img src="\${imgUrl}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 10px; border: 1px solid #f1f5f9; margin-right: 20px;">
                        <div>
                            <div style="font-weight: 800; color: #1e293b; font-size: 14px;">\${name}</div>
                            <div style="font-size: 11px; color: #94a3b8; font-weight: 600; margin-top: 3px;">Authentic Vimal Stock</div>
                        </div>
                    </td>
                    <td style="padding: 15px; text-align: center; color: #1e293b; font-size: 14px; font-weight: 700;">\${qty}</td>
                    <td style="padding: 15px; text-align: right; font-weight: 800; color: #1e293b; font-size: 14px;">\${total}</td>
                </tr>`;
        });

        const invoiceElement = document.getElementById('printableInvoice');

        if (mode === 'print') {
            window.print();
        } else {
            // High-Quality PDF Generation
            invoiceElement.style.display = 'block'; 
            const opt = {
                margin: 0.2,
                filename: 'Invoice_' + card.querySelector('.order-ref').innerText + '.pdf',
                image: { type: 'jpeg', quality: 1 },
                html2canvas: { scale: 3, useCORS: true, letterRendering: true },
                jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
            };
            
            html2pdf().set(opt).from(invoiceElement).save().then(() => {
                invoiceElement.style.display = 'none';
            });
        }
    }
</script>

</body>
